# Synthetic, test-only values for the disposable fixture stack. They protect
# nothing: the stack binds to 127.0.0.1 and has no persistent volume.
POSTGRES_PASSWORD=fixture-postgres-password-not-secret
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=fixture-jwt-secret-not-secret-0123456789abcdef
JWT_EXPIRY=3600
PG_META_CRYPTO_KEY=fixture-pg-meta-crypto-key-not-secret
# HS256 tokens signed with JWT_SECRET above, valid until 2050. Synthetic.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWZpeHR1cmUiLCJpYXQiOjE3NjI1NjAwMDAsImV4cCI6MjUyNDYwODAwMH0.qBR73zGccioGj-21F3VOnepPg1slGmx3u-28mO1kxVY
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZml4dHVyZSIsImlhdCI6MTc2MjU2MDAwMCwiZXhwIjoyNTI0NjA4MDAwfQ.NhLp8BMtBZIdxev5mIrd668gJfvn3ta7uUbtLy35n6I
# Studio login for the gateway's catch-all route. Letters and digits only,
# as upstream asks; at least 16 characters, as the dashboard asks.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=fixturestudiopassword0123456789
# Realtime: the 16-byte key for its tenant table and its Phoenix secret.
REALTIME_DB_ENC_KEY=fixturertenckey0
REALTIME_SECRET_KEY_BASE=fixture-realtime-secret-key-base-not-secret-0123456789abcdef0123
# Opaque API keys and the ES256 key pair. The key pair and JWKS are made
# the way upstream's utils/add-new-auth-keys.sh makes them, from JWT_SECRET
# above. The opaque keys are fixed strings outside the real key format, so
# secret scanners do not take them for real keys; Envoy compares them as
# they are. Synthetic.
# Envoy translates the opaque keys to the ES256 JWTs below; Kong stays in
# legacy key mode. JWT_JWKS also holds JWT_SECRET, so the HS256 keys above
# keep working everywhere.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_fixture.synthetic.not.a.real.key
SUPABASE_SECRET_KEY=sb_secret_fixture.synthetic.not.a.real.key
