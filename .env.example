# Local development settings. Copy to `.env`; cargo-leptos loads it.
# These values are for a disposable local database only.
SUPABASE_DASHBOARD_ENV=development
SUPABASE_DASHBOARD_DATABASE_URL=postgres://dashboard:dashboard-dev-only@127.0.0.1:55432/dashboard
# Optional: run the database integration tests against this server.
# SUPABASE_DASHBOARD_TEST_DATABASE_URL=postgres://dashboard:dashboard-dev-only@127.0.0.1:55432/dashboard
