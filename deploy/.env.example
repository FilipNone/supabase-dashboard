# supabase-dashboard deployment settings. Copy to `.env` next to compose.yaml
# and keep it private (chmod 600 .env). Never commit the filled-in file.

# Image tag to run. Change it to upgrade; see the release notes first.
SUPABASE_DASHBOARD_VERSION=0.1.0-dev.3

# Address operators type in the browser. Must be https:// in production.
SUPABASE_DASHBOARD_PUBLIC_URL=https://dashboard.example.com

# Password for the metadata database. Generate one with:
#   openssl rand -hex 32
# Use letters and digits only: it is placed in a postgres:// URL unescaped.
POSTGRES_PASSWORD=

# Only for the bundled Caddy proxy (`--profile caddy`): the host name from
# SUPABASE_DASHBOARD_PUBLIC_URL. Its DNS record must point at this server,
# and ports 80 and 443 must be reachable for the certificate.
SUPABASE_DASHBOARD_DOMAIN=dashboard.example.com

# Where the dashboard listens on the host. Keep 127.0.0.1 behind a proxy on
# the same machine.
# SUPABASE_DASHBOARD_BIND=127.0.0.1
# SUPABASE_DASHBOARD_PORT=3000

# Optional server settings (defaults shown). The full list is under
# Configuration in https://github.com/FilipNone/supabase-dashboard/blob/main/docs/development.md
# SUPABASE_DASHBOARD_SESSION_LIFETIME_HOURS=12
# SUPABASE_DASHBOARD_SESSION_IDLE_TIMEOUT_MINS=60
# SUPABASE_DASHBOARD_LOG_FORMAT=json
# RUST_LOG=info,tower_http=info,sqlx=warn

# Trying it out without TLS on a private network only: uncomment the next
# line, set SUPABASE_DASHBOARD_BIND=0.0.0.0 above, and set the public URL to
# http://<server>:<port>. Session cookies are then sent without the Secure
# flag and logs are human-readable. Do not use this on the internet.
# SUPABASE_DASHBOARD_ENV=development
